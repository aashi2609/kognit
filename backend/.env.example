# Kognit Backend Environment

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- LLM API Keys ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Server ---
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- SSL (optional) ---
# On corporate networks with SSL inspection (e.g. Zscaler), set this to 1
# once the corporate root certificate is trusted, otherwise leave at 0.
KOGNIT_SSL_VERIFY=0
